# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (optional): if set, one-time links will be stored in Supabase.
SUPABASE_URL="https://yxmwuswjyqvfsqqfkjdv.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl4bXd1c3dqeXF2ZnNxcWZramR2Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDU0NTkwMCwiZXhwIjoyMDk2MTIxOTAwfQ.d44vY0hA532X0_zoLHe9pcOmrIKQaDEfCPnayl59r8g"
SUPABASE_TABLE="one_time_links"
LINK_TTL_HOURS="24"

# Admin security for dashboard and one-time link generation
ADMIN_USERNAME="CasaOT"
ADMIN_PASSWORD="cambia_esta_clave"
# Preferred over ADMIN_PASSWORD in production.
# Format: scrypt$<salt_hex>$<hash_hex>
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_TTL_HOURS="8"
# Cookie security mode: auto | true | false
# auto = secure cookie only when request is HTTPS
ADMIN_COOKIE_SECURE="auto"
